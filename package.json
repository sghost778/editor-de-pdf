{
  "name": "pdf-converter",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/main/electron/main.js",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit --project tsconfig.json && tsc --project tsconfig.main.json && vite build --config vite.config.ts",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:pdf-export": "npm run build && electron tests/electron-export-smoke.cjs",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0",
    "test": "vitest run --config vitest.config.ts --pool=threads --maxWorkers=1 --minWorkers=1"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.57.0",
    "@fluentui/react-icons": "^2.0.2",
    "cors": "^2.8.5",
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.0.0",
    "tslib": "^2.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.pdfconverter.desktop",
    "productName": "PDF Converter",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PDF-Converter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Converter"
    }
  }
}
